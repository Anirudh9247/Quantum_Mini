# ── Frontend → Backend API URL ───────────────────────────────────────────────
# Used in: next.config.ts (CSP connect-src), src/lib/api.ts
# Dev: http://127.0.0.1:8000
# Prod: https://qrng-api.onrender.com  (or your chosen backend URL)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
