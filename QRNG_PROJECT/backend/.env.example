# ─────────────────────────────────────────────────────────────────────────────
# QRNG Interactive — Backend Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Dev:  http://localhost:3000,http://127.0.0.1:3000
# Prod: https://qrng-frontend.vercel.app  (exact production URL)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Dev (SQLite):       sqlite:///./qrng.db
# Prod (PostgreSQL):  postgresql://user:password@host:5432/qrng_db
DATABASE_URL=sqlite:///./qrng.db

# ── ANU QRNG API ─────────────────────────────────────────────────────────────
# Physical quantum random number source. Leave empty to always use Qiskit Aer.
# ANU_API_URL=https://qrng.anu.edu.au/API/jsonI.php
