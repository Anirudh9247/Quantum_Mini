# ─────────────────────────────────────────────────────────────────────────────
# QRNG Interactive — Backend Environment Template
# Copy this file to .env and fill in for LOCAL DEVELOPMENT only.
#
# PRODUCTION (Cloud Run): secrets are managed via Google Secret Manager.
# Set them with:
#   gcloud secrets create qrng-database-url --data-file=- <<< "postgresql+psycopg2://..."
#   gcloud secrets create qrng-allowed-origins --data-file=- <<< "https://your-pages-domain"
# ─────────────────────────────────────────────────────────────────────────────

# ── CORS ─────────────────────────────────────────────────────────────────────
# Dev:  http://localhost:3000,http://127.0.0.1:3000
# Prod: https://qrng-interactive.pages.dev  ← your Cloudflare Pages URL
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Dev (SQLite):       sqlite:///./qrng.db
# Dev (Docker PG):    postgresql+psycopg2://qrng_user:qrng_local_dev@db:5432/qrng_db
# Prod (Cloud SQL):   postgresql+psycopg2://USER:PASSWORD@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=sqlite:///./qrng.db
